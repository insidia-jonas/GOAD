# Generated by the GOAD elastic_security role. Secrets are injected at runtime.
server.host: "0.0.0.0"
server.publicBaseUrl: "{{ elastic_kibana_url }}"
elasticsearch.hosts: ["https://127.0.0.1:{{ elastic_es_port }}"]
elasticsearch.username: "kibana_system"
elasticsearch.password: "{{ elastic_kibana_system_secret }}"
elasticsearch.ssl.certificateAuthorities: ["/etc/kibana/http_ca.crt"]
elasticsearch.ssl.verificationMode: certificate
xpack.encryptedSavedObjects.encryptionKey: "{{ elastic_eso_key }}"
xpack.security.encryptionKey: "{{ elastic_security_key }}"
xpack.reporting.encryptionKey: "{{ elastic_reporting_key }}"
telemetry.optIn: false
newsfeed.enabled: false
