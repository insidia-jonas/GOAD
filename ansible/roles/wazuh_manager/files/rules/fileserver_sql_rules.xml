<!--
  File-server, SMB and MSSQL detections for the GOAD lab.
  Rule IDs: 100900 - 100949
-->

<group name="windows,smb,mssql,fileserver,goad,">

  <!-- T1021.002 - SMB share mapped / net use -->
  <rule id="100900" level="6">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)net\s+use\s+</field>
    <mitre>
      <id>T1021.002</id>
    </mitre>
    <description>GOAD: SMB share mapped via net use</description>
    <group>attack,lateral_movement,</group>
  </rule>

  <!-- Sensitive file names on shares (creds / SQL) -->
  <rule id="100901" level="12">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(web\.config|connectionstring|sa_password|registered.?servers|passwords?\.txt|credentials\.csv|unattend\.xml)</field>
    <mitre>
      <id>T1552.001</id>
    </mitre>
    <description>GOAD: Access or copy of likely plaintext credential files</description>
    <group>attack,credential_access,</group>
  </rule>

  <!-- T1046 MSSQL client tools / sqlcmd against remote -->
  <rule id="100910" level="8">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)(sqlcmd|osql|sqlps|ssms)\.exe$</field>
    <mitre>
      <id>T1190</id>
    </mitre>
    <description>GOAD: Microsoft SQL client executed</description>
    <group>attack,lateral_movement,</group>
  </rule>

  <rule id="100911" level="12">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(sqlcmd|osql).*-[Pp]\s</field>
    <mitre>
      <id>T1078</id>
      <id>T1190</id>
    </mitre>
    <description>GOAD: sqlcmd with password on the command line</description>
    <group>attack,credential_access,</group>
  </rule>

  <!-- xp_cmdshell / OLE automation abuse -->
  <rule id="100912" level="14">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(xp_cmdshell|sp_OACreate|OPENROWSET|OPENDATASOURCE|ENABLE_XP_CMDSHELL)</field>
    <mitre>
      <id>T1505.001</id>
    </mitre>
    <description>GOAD: MSSQL dangerous stored-procedure / linked-server abuse</description>
    <group>attack,execution,persistence,</group>
  </rule>

  <!-- T1003.001 - Proc dump of sqlservr -->
  <rule id="100913" level="13">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(sqlservr|SQLEXPRESS).*(procdump|minidump|comsvcs)</field>
    <mitre>
      <id>T1003</id>
    </mitre>
    <description>GOAD: Memory dump targeting SQL Server process</description>
    <group>attack,credential_access,</group>
  </rule>

  <!-- T1083 - bulk copy of file-server trees -->
  <rule id="100920" level="8">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(robocopy|xcopy|Copy-Item\s+-Recurse).*(FileServer|shares|archives|thewall)</field>
    <mitre>
      <id>T1039</id>
    </mitre>
    <description>GOAD: Recursive copy from a lab file-server path</description>
    <group>attack,collection,</group>
  </rule>

  <!-- Event 5140 / 5145 share access (Windows Security, parent 60109) -->
  <rule id="100921" level="5">
    <if_sid>60109</if_sid>
    <field name="win.system.eventID">^5140$</field>
    <mitre>
      <id>T1039</id>
    </mitre>
    <description>GOAD: Network share object accessed (5140)</description>
    <group>attack,collection,</group>
  </rule>

  <rule id="100922" level="10">
    <if_sid>60109</if_sid>
    <field name="win.system.eventID">^5145$</field>
    <field name="win.eventdata.shareName" type="pcre2">(?i)(FileServer|Finance|SQL|IT|HR|Legal|archives|thewall)</field>
    <mitre>
      <id>T1039</id>
      <id>T1552.001</id>
    </mitre>
    <description>GOAD: Detailed share access on a sensitive file-server share (5145)</description>
    <group>attack,collection,credential_access,</group>
  </rule>

  <!-- MSSQL login failed / sa brute (18456) via application log if forwarded -->
  <rule id="100930" level="10">
    <if_sid>60109</if_sid>
    <field name="win.system.eventID">^18456$</field>
    <mitre>
      <id>T1110</id>
    </mitre>
    <description>GOAD: MSSQL login failed (possible brute force)</description>
    <group>attack,credential_access,</group>
  </rule>

</group>
