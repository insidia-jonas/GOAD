<!--
  MITRE ATT&CK Wazuh Rules for Sysmon Events
  Optimized for GOAD Active Directory Lab

  Based on:
  - BernaldoPenasAntelo/Windows-MITRE_ATT-CK-Wazuh-Rules
  - SOCFortress Wazuh Rules
  - MITRE ATT&CK Framework v14
-->

<group name="sysmon,mitre,">

  <!-- ============================================= -->
  <!-- Sysmon Event ID 1: Process Creation Detection -->
  <!-- ============================================= -->

  <!-- T1059.001 - PowerShell Execution with Suspicious Arguments -->
  <rule id="100001" level="12">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)powershell\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(-enc|-encodedcommand|-e\s)</field>
    <mitre>
      <id>T1059.001</id>
    </mitre>
    <description>MITRE ATT&CK T1059.001: PowerShell with encoded command detected</description>
    <group>attack,execution,</group>
  </rule>

  <!-- T1059.001 - PowerShell Download Cradle -->
  <rule id="100002" level="14">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)powershell\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(downloadstring|downloadfile|invoke-webrequest|iwr\s|wget\s|curl\s|invoke-restmethod)</field>
    <mitre>
      <id>T1059.001</id>
      <id>T1105</id>
    </mitre>
    <description>MITRE ATT&CK T1059.001/T1105: PowerShell download cradle detected</description>
    <group>attack,execution,ingress_tool_transfer,</group>
  </rule>

  <!-- T1059.001 - PowerShell AMSI Bypass Attempt -->
  <rule id="100003" level="15">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(amsi\.dll|AmsiInitFailed|AmsiScanBuffer|amsiutils|Invoke-AmsiBypass)</field>
    <mitre>
      <id>T1059.001</id>
      <id>T1562.001</id>
    </mitre>
    <description>MITRE ATT&CK T1562.001: AMSI bypass attempt detected</description>
    <group>attack,defense_evasion,</group>
  </rule>

  <!-- T1003.001 - LSASS Memory Dump via Procdump -->
  <rule id="100010" level="15">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)procdump(64)?\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)lsass</field>
    <mitre>
      <id>T1003.001</id>
    </mitre>
    <description>MITRE ATT&CK T1003.001: LSASS memory dump via Procdump detected</description>
    <group>attack,credential_access,</group>
  </rule>

  <!-- T1003 - Mimikatz Execution -->
  <rule id="100011" level="15">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(sekurlsa|lsadump|kerberos::|crypto::|privilege::debug|token::elevate|misc::skeleton)</field>
    <mitre>
      <id>T1003</id>
      <id>T1558</id>
    </mitre>
    <description>MITRE ATT&CK T1003: Mimikatz command execution detected</description>
    <group>attack,credential_access,</group>
  </rule>

  <!-- T1003.006 - DCSync Attack Detection -->
  <rule id="100012" level="15">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(dcsync|lsadump::dcsync|Get-ADReplAccount)</field>
    <mitre>
      <id>T1003.006</id>
    </mitre>
    <description>MITRE ATT&CK T1003.006: DCSync attack detected</description>
    <group>attack,credential_access,</group>
  </rule>

  <!-- T1558.003 - Kerberoasting -->
  <rule id="100013" level="14">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(Invoke-Kerberoast|Get-SPNTicket|kerberos::list|rubeus.*(kerberoast|asreproast))</field>
    <mitre>
      <id>T1558.003</id>
    </mitre>
    <description>MITRE ATT&CK T1558.003: Kerberoasting attack detected</description>
    <group>attack,credential_access,</group>
  </rule>

  <!-- T1558.004 - AS-REP Roasting -->
  <rule id="100014" level="14">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(asreproast|Get-ASRepHash|rubeus.*asrep)</field>
    <mitre>
      <id>T1558.004</id>
    </mitre>
    <description>MITRE ATT&CK T1558.004: AS-REP Roasting attack detected</description>
    <group>attack,credential_access,</group>
  </rule>

  <!-- T1069 - BloodHound/SharpHound Execution -->
  <rule id="100020" level="13">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)(sharphound|bloodhound)</field>
    <mitre>
      <id>T1069</id>
      <id>T1087</id>
    </mitre>
    <description>MITRE ATT&CK T1069: BloodHound/SharpHound AD enumeration detected</description>
    <group>attack,discovery,</group>
  </rule>

  <!-- T1069.002 - Domain Group Discovery via PowerShell -->
  <rule id="100021" level="10">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(Get-DomainGroup|Get-ADGroup|Get-DomainUser|Get-ADUser|Get-DomainComputer|Get-ADComputer)</field>
    <mitre>
      <id>T1069.002</id>
      <id>T1087.002</id>
    </mitre>
    <description>MITRE ATT&CK T1069.002: Domain enumeration via PowerShell detected</description>
    <group>attack,discovery,</group>
  </rule>

  <!-- T1021.002 - PsExec Execution -->
  <rule id="100030" level="12">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)psexec(64)?\.exe$</field>
    <mitre>
      <id>T1021.002</id>
      <id>T1569.002</id>
    </mitre>
    <description>MITRE ATT&CK T1021.002: PsExec remote execution detected</description>
    <group>attack,lateral_movement,</group>
  </rule>

  <!-- T1218.005 - Mshta Execution -->
  <rule id="100040" level="12">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)mshta\.exe$</field>
    <mitre>
      <id>T1218.005</id>
    </mitre>
    <description>MITRE ATT&CK T1218.005: Mshta.exe execution detected (possible LOLBAS)</description>
    <group>attack,defense_evasion,execution,</group>
  </rule>

  <!-- T1218.010 - Regsvr32 Execution -->
  <rule id="100041" level="10">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)regsvr32\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(\/s|\/i:|scrobj)</field>
    <mitre>
      <id>T1218.010</id>
    </mitre>
    <description>MITRE ATT&CK T1218.010: Suspicious Regsvr32 execution detected</description>
    <group>attack,defense_evasion,</group>
  </rule>

  <!-- T1218.011 - Rundll32 Suspicious Execution -->
  <rule id="100042" level="10">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)rundll32\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(javascript|vbscript|mshtml|shell32.*shellexec_rundll|url\.dll.*openurl|url\.dll.*fileprotocolhandler)</field>
    <mitre>
      <id>T1218.011</id>
    </mitre>
    <description>MITRE ATT&CK T1218.011: Suspicious Rundll32 execution detected</description>
    <group>attack,defense_evasion,</group>
  </rule>

  <!-- T1105 - Certutil Download -->
  <rule id="100050" level="12">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)certutil\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(-urlcache|-split|http|ftp)</field>
    <mitre>
      <id>T1105</id>
      <id>T1140</id>
    </mitre>
    <description>MITRE ATT&CK T1105: Certutil used for file download/decode</description>
    <group>attack,ingress_tool_transfer,</group>
  </rule>

  <!-- T1105 - BitsAdmin Download -->
  <rule id="100051" level="12">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)bitsadmin\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(\/transfer|\/download|http|ftp)</field>
    <mitre>
      <id>T1105</id>
      <id>T1197</id>
    </mitre>
    <description>MITRE ATT&CK T1105: BitsAdmin used for file download</description>
    <group>attack,ingress_tool_transfer,</group>
  </rule>

  <!-- T1547.001 - Registry Run Key Modification via reg.exe -->
  <rule id="100060" level="12">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)reg\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(add.*\\run|add.*\\runonce)</field>
    <mitre>
      <id>T1547.001</id>
    </mitre>
    <description>MITRE ATT&CK T1547.001: Registry Run key persistence via reg.exe</description>
    <group>attack,persistence,</group>
  </rule>

  <!-- T1053.005 - Scheduled Task Creation -->
  <rule id="100061" level="10">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)schtasks\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\/create</field>
    <mitre>
      <id>T1053.005</id>
    </mitre>
    <description>MITRE ATT&CK T1053.005: Scheduled task creation detected</description>
    <group>attack,persistence,execution,</group>
  </rule>

  <!-- T1543.003 - Service Creation via sc.exe -->
  <rule id="100062" level="10">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)sc\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(create|config)</field>
    <mitre>
      <id>T1543.003</id>
    </mitre>
    <description>MITRE ATT&CK T1543.003: Windows service manipulation via sc.exe</description>
    <group>attack,persistence,</group>
  </rule>

  <!-- T1087.002 - Net.exe Domain Enumeration -->
  <rule id="100070" level="8">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)net(1)?\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(user\s|group\s|localgroup\s|accounts\s).*\/domain</field>
    <mitre>
      <id>T1087.002</id>
    </mitre>
    <description>MITRE ATT&CK T1087.002: Domain account enumeration via net.exe</description>
    <group>attack,discovery,</group>
  </rule>

  <!-- T1016 - Nltest Domain Trust Enumeration -->
  <rule id="100071" level="10">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)nltest\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(\/dclist|\/domain_trusts|\/trusted_domains)</field>
    <mitre>
      <id>T1016</id>
      <id>T1482</id>
    </mitre>
    <description>MITRE ATT&CK T1482: Domain trust discovery via nltest</description>
    <group>attack,discovery,</group>
  </rule>

  <!-- T1033 - Whoami Execution -->
  <rule id="100072" level="6">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)whoami\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(\/all|\/groups|\/priv)</field>
    <mitre>
      <id>T1033</id>
    </mitre>
    <description>MITRE ATT&CK T1033: System owner/user discovery via whoami</description>
    <group>attack,discovery,</group>
  </rule>

  <!-- ============================================= -->
  <!-- Sysmon Event ID 3: Network Connection -->
  <!-- ============================================= -->

  <!-- T1071.001 - Suspicious PowerShell Network Connection -->
  <rule id="100100" level="10">
    <if_sid>61605</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)powershell\.exe$</field>
    <mitre>
      <id>T1071.001</id>
    </mitre>
    <description>MITRE ATT&CK T1071.001: PowerShell network connection detected</description>
    <group>attack,command_control,</group>
  </rule>

  <!-- ============================================= -->
  <!-- Sysmon Event ID 8: CreateRemoteThread -->
  <!-- ============================================= -->

  <!-- T1055 - Process Injection into LSASS -->
  <rule id="100200" level="15">
    <if_sid>61610</if_sid>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)lsass\.exe$</field>
    <mitre>
      <id>T1055</id>
      <id>T1003.001</id>
    </mitre>
    <description>MITRE ATT&CK T1055: Remote thread created in LSASS - possible credential theft</description>
    <group>attack,credential_access,defense_evasion,</group>
  </rule>

  <!-- ============================================= -->
  <!-- Sysmon Event ID 10: Process Access -->
  <!-- ============================================= -->

  <!-- T1003.001 - LSASS Access with Suspicious Permissions -->
  <rule id="100300" level="14">
    <if_sid>61612</if_sid>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)lsass\.exe$</field>
    <field name="win.eventdata.grantedAccess" type="pcre2">(?i)(0x1010|0x1410|0x1438|0x143a|0x1fffff)</field>
    <mitre>
      <id>T1003.001</id>
    </mitre>
    <description>MITRE ATT&CK T1003.001: LSASS access with credential dumping permissions</description>
    <group>attack,credential_access,</group>
  </rule>

  <!-- ============================================= -->
  <!-- Sysmon Event ID 11: File Created -->
  <!-- ============================================= -->

  <!-- T1547.001 - Startup Folder Persistence -->
  <rule id="100400" level="12">
    <if_sid>61613</if_sid>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)\\Startup\\.*\.(exe|dll|bat|cmd|ps1|vbs|js|hta)$</field>
    <mitre>
      <id>T1547.001</id>
    </mitre>
    <description>MITRE ATT&CK T1547.001: Executable created in Startup folder</description>
    <group>attack,persistence,</group>
  </rule>

  <!-- ============================================= -->
  <!-- Sysmon Event ID 12,13,14: Registry Events -->
  <!-- ============================================= -->

  <!-- T1547.001 - Registry Run Key Persistence -->
  <rule id="100500" level="12">
    <if_sid>61614,61615,61616</if_sid>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)\\CurrentVersion\\Run</field>
    <mitre>
      <id>T1547.001</id>
    </mitre>
    <description>MITRE ATT&CK T1547.001: Registry Run key modification detected</description>
    <group>attack,persistence,</group>
  </rule>

  <!-- T1546.003 - WMI Event Subscription -->
  <rule id="100501" level="12">
    <if_sid>61614,61615,61616</if_sid>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)WMI\\</field>
    <mitre>
      <id>T1546.003</id>
    </mitre>
    <description>MITRE ATT&CK T1546.003: WMI event subscription detected</description>
    <group>attack,persistence,</group>
  </rule>

  <!-- T1547.010 - Print Spooler Registry Modification -->
  <rule id="100502" level="12">
    <if_sid>61614,61615,61616</if_sid>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)\\Control\\Print\\Monitors\\</field>
    <mitre>
      <id>T1547.010</id>
    </mitre>
    <description>MITRE ATT&CK T1547.010: Print Monitor persistence detected</description>
    <group>attack,persistence,</group>
  </rule>

  <!-- ============================================= -->
  <!-- Sysmon Event ID 17,18: Named Pipes -->
  <!-- ============================================= -->

  <!-- T1021.002 - PsExec Named Pipe -->
  <rule id="100600" level="12">
    <if_sid>61619,61620</if_sid>
    <field name="win.eventdata.pipeName" type="pcre2">(?i)\\psexecsvc</field>
    <mitre>
      <id>T1021.002</id>
    </mitre>
    <description>MITRE ATT&CK T1021.002: PsExec named pipe activity detected</description>
    <group>attack,lateral_movement,</group>
  </rule>

  <!-- T1187 - Forced Authentication Named Pipes -->
  <rule id="100601" level="10">
    <if_sid>61619,61620</if_sid>
    <field name="win.eventdata.pipeName" type="pcre2">(?i)(spoolss|efsrpc|lsarpc|samr|netlogon)</field>
    <mitre>
      <id>T1187</id>
    </mitre>
    <description>MITRE ATT&CK T1187: Named pipe connection to sensitive RPC service</description>
    <group>attack,credential_access,</group>
  </rule>

</group>
