[default]
; Note: ansible_host *MUST* be an IPv4 address or setting things like DNS
; servers will break.
; ------------------------------------------------
; sevenkingdoms.local
; ------------------------------------------------
dc01 ansible_host={{ip_range}}.10 dns_domain=dc01 dict_key=dc01
; ------------------------------------------------
; north.sevenkingdoms.local
; ------------------------------------------------
dc02 ansible_host={{ip_range}}.11 dns_domain=dc01 dict_key=dc02
srv02 ansible_host={{ip_range}}.22 dns_domain=dc02 dict_key=srv02
; ------------------------------------------------
; essos.local
; ------------------------------------------------
dc03 ansible_host={{ip_range}}.12 dns_domain=dc03 dict_key=dc03
srv03 ansible_host={{ip_range}}.23 dns_domain=dc03 dict_key=srv03
; ------------------------------------------------
; legacy server (2012 R2) - sevenkingdoms.local
; ------------------------------------------------
srv04 ansible_host={{ip_range}}.24 dns_domain=dc01 dict_key=srv04
; ------------------------------------------------
; workstation
; ------------------------------------------------
ws02 ansible_host={{ip_range}}.32 dns_domain=dc01 dict_key=ws02
; ------------------------------------------------
; wazuh EDR server (Linux - Ubuntu)
; ------------------------------------------------
wazuh ansible_host={{ip_range}}.51 ansible_connection=ssh ansible_user=vagrant ansible_ssh_common_args='-o StrictHostKeyChecking=no'
{% if not replace_debian_router|default(false) %}
; Debian lab router / perimeter (replaced by sophos_xgs)
router ansible_host={{ip_range}}.53 dict_key=router ansible_connection=ssh ansible_user=vagrant ansible_ssh_common_args='-o StrictHostKeyChecking=no'

[lab_router]
router

[perimeter]
router
{% endif %}
