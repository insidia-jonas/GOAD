[default]
; Note: ansible_host *MUST* be an IPv4 address or setting things like DNS
; servers will break.
; ------------------------------------------------
; sevenkingdoms.local
; ------------------------------------------------
dc01 ansible_host={{ip_range}}.10 dns_domain=dc01 dict_key=dc01
; ------------------------------------------------
; north.sevenkingdoms.local
; ------------------------------------------------
dc02 ansible_host={{ip_range}}.11 dns_domain=dc01 dict_key=dc02
srv02 ansible_host={{ip_range}}.22 dns_domain=dc02 dict_key=srv02
; ------------------------------------------------
; essos.local
; ------------------------------------------------
dc03 ansible_host={{ip_range}}.12 dns_domain=dc03 dict_key=dc03
srv03 ansible_host={{ip_range}}.23 dns_domain=dc03 dict_key=srv03
; ------------------------------------------------
; legacy server (2012 R2) - sevenkingdoms.local
; ------------------------------------------------
srv04 ansible_host={{ip_range}}.24 dns_domain=dc01 dict_key=srv04
; ------------------------------------------------
; workstations (Windows 10/11 - need explicit WinRM settings)
; ------------------------------------------------
ws01 ansible_host={{ip_range}}.31 dns_domain=dc01 dict_key=ws01 ansible_winrm_transport=ntlm ansible_winrm_scheme=http ansible_port=5985
ws02 ansible_host={{ip_range}}.32 dns_domain=dc01 dict_key=ws02 ansible_winrm_transport=ntlm ansible_winrm_scheme=http ansible_port=5985
; ------------------------------------------------
; wazuh EDR server (Linux - Debian 12)
; ------------------------------------------------
wazuh ansible_host={{ip_range}}.51 dict_key=wazuh ansible_connection=ssh ansible_user=debian ansible_password=debian ansible_ssh_common_args='-o StrictHostKeyChecking=no'
; ------------------------------------------------
; Kali Linux - Attacker VM
; ------------------------------------------------
kali ansible_host={{ip_range}}.50 dict_key=kali ansible_connection=ssh ansible_user=kali ansible_password=kali ansible_ssh_common_args='-o StrictHostKeyChecking=no'
; ------------------------------------------------
; Commando VM - Windows Attacker VM (Windows 11 - needs explicit WinRM settings)
; ------------------------------------------------
commando ansible_host={{ip_range}}.52 dict_key=commando ansible_connection=winrm ansible_winrm_server_cert_validation=ignore ansible_winrm_transport=ntlm ansible_winrm_scheme=http ansible_port=5985
{% if not replace_debian_router|default(false) %}
; Debian lab router / perimeter (replaced by sophos_xgs)
router ansible_host={{ip_range}}.53 dict_key=router ansible_connection=ssh ansible_user=debian ansible_password=debian ansible_ssh_common_args='-o StrictHostKeyChecking=no'

[lab_router]
router

[perimeter]
router
{% endif %}

[all:vars]
force_dns_server=no
dns_server={{ip_range}}.254

dns_server_forwarder={{ip_range}}.254

ansible_user=localuser
ansible_password=password